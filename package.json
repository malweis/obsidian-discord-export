{
  "name": "discord-export",
  "version": "1.0.0",
  "description": "Obsidian plugin to export notes to Discord-ready formatted chunks",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "malweis",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "approvedBuilds": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0"
  }
}
